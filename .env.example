# Obtém a chave secreta em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_REDACTED
STRIPE_PRO_PRICE_ID=price_1TbKy7QdlPUKQK2wQmXUzWOM

# === Gateway ===
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
PUBLIC_URL=http://localhost:8080

# # === Ngrok (dev only) ===
# NGROK_AUTH_TOKEN=

# === Planos ===
FREE_TIER_MAX_SERVERS=1
FREE_TIER_RPM=10
PRO_TIER_MAX_SERVERS=10
PRO_TIER_RPM=100

# === Rate limiting de autenticação (token bucket por IP, modelo Supabase) ===
# Capacidade do bucket (rajada máxima permitida) antes do 429.
AUTH_RATE_LIMIT_BURST=30
# Taxa de recarga em requests por hora para cada endpoint.
AUTH_LOGIN_RATE_PER_HOUR=360
AUTH_REGISTER_RATE_PER_HOUR=30
AUTH_CREDENTIALS_RATE_PER_HOUR=120
# Se true, confia em Sb-Forwarded-For / X-Forwarded-For para obter o IP real atrás de proxy.
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
