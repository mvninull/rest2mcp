                                elif hasattr(block, "data"):
                                    blocks.append(str(block.data))
                                else:
                                    blocks.append(str(block))
                            return "\n".join(blocks)
                        return ""
                return handler

            handler_fn = _make_handler(tool_name, sess)

            fn_tool = FunctionTool(
                fn=handler_fn,
                name=qualified_name,
                description=src_tool.description or "",
                parameters=dict(
                    type="object",
                    properties=dict(src_tool.inputSchema.get("properties", {})),
                    required=list(src_tool.inputSchema.get("required", [])),
                ),
            )

            base_mcp.add_tool(fn_tool)
            registered.append(qualified_name)

    return registered
