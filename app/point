# -----------------------------------------------------------
# Helpers for connecting to source MCP servers directly via mcp
# (no FastMCPProxy, no proxy-to-proxy SSE issues)
# -----------------------------------------------------------

@asynccontextmanager
async def _stdio_session(stdio_cfg: dict):
    """Connect to a stdio MCP subprocess and yield a ClientSession."""
    from mcp.client.session import ClientSession
    from mcp.client.stdio import StdioServerParameters, stdio_client

    cmd = stdio_cfg.get("command") or stdio_cfg.get("cmd", "")
    args = stdio_cfg.get("args", [])
    env = stdio_cfg.get("env", None)
    cwd = stdio_cfg.get("cwd", None)

    params = StdioServerParameters(command=cmd, args=args, env=env, cwd=cwd)
    async with stdio_client(params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            yield session


@asynccontextmanager
async def _sse_session(url: str):
    """Connect to an MCP server via SSE and yield a ClientSession."""
    from mcp.client.session import ClientSession
    from mcp.client.sse import sse_client

    async with sse_client(url) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            yield session


async def _add_source_tools_to_server(
    base_mcp: FastMCP,
    source_name: str,
    namespace: str,
    stdio_cfg: dict | None = None,
    remote_url: str | None = None,
):
    """Connect to a source MCP server (stdio or SSE), list tools, and register
    forwarding functions as native tools on base_mcp.  Returns the list of
    registered tool names."""
    if stdio_cfg:
        cm = _stdio_session(stdio_cfg)
    elif remote_url:
        cm = _sse_session(remote_url)
    else:
        logger.warning("Source %s has no stdio_cfg or remote_url, skipping", source_name)
        return []

    from fastmcp.tools.tool import FunctionTool

    registered = []
    async with cm as session:
        tools_result = await session.list_tools()
        logger.info("Source %s has %d tools", source_name, len(tools_result.tools))

        for src_tool in tools_result.tools:
            tool_name = src_tool.name
            qualified_name = f"{namespace}/{tool_name}" if namespace else tool_name

            async def _make_handler(tname: str, sess):
                async def handler(**kwargs):
                    result = await sess.call_tool(tname, kwargs)
                    if result.content:
                        blocks = []
                        for block in result.content:
                            if hasattr(block, "text"):
                                blocks.append(block.text)
                            elif hasattr(block, "data"):
                                blocks.append(str(block.data))
                            else:
                                blocks.append(str(block))
                        return "\n".join(blocks)
                    return ""
                return handler

            handler_fn = await _make_handler(tool_name, session)

            fn_tool = FunctionTool.from_function(
                fn=handler_fn,
                name=qualified_name,
                description=src_tool.description or "",
            )
            fn_tool.parameters = dict(
                name="params",
                type="object",
                properties={
                    k: v
                    for k, v in src_tool.inputSchema.get("properties", {}).items()
                },
                required=src_tool.inputSchema.get("required", []),
            )

            base_mcp.add_tool(fn_tool)
            registered.append(qualified_name)

    return registered


