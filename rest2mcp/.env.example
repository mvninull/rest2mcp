# Copie para rest2mcp/.env e preencha com os valores reais do seu projeto.
# Estas são chaves PÚBLICAS (publishable) — o bundle do frontend é público.
# As chaves SECRETAS nunca devem ficar aqui (só no backend / Fly secrets).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# O frontend (Vite) apenas expõe variáveis com prefixo VITE_ durante o build.
# Preencha com os MESMOS valores de SUPABASE_URL / SUPABASE_ANON_KEY acima.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe publishable key (dashboard.stripe.com/apikeys) e o preço Pro (produto).
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE_ID

# PayPal client id (semi-público, usado pelo SDK do botão). 
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id