        if ev.get("default"):
            prop["default"] = ev["default"]
        properties[name] = prop
        if ev.get("isRequired"):
            required.append(name)
    
    schema: dict = {"type": "object", "properties": properties}
    if required:
        schema["required"] = required
    return schema


