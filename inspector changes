    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--border);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
}
.auth-login-btn:hover {
    background: var(--border-strong);
    color: var(--ink);
}
.auth-login-btn svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

/* ── SUBSCRIPTION ───────────────────────────────────────── */
.sub-section {
    margin-top: 8px;
    padding: 0.75rem 1.1rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
}
.sub-title {
    font-family: var(--mono);
    font-size: 0.55rem;
    font-weight: 700;
