}
.status-badge.error {
    color: var(--warn);
}
.log-detail-section {
    margin-bottom: 1rem;
}
.log-detail-section h4 {
    font-family: var(--display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
