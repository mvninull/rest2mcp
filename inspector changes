        flex-wrap: wrap;
        animation: fadeUp 0.7s 0.3s ease both;
      }
      .btn-primary {
        background: var(--ink);
        color: white;
        padding: 14px 28px;
        border-radius: 6px;
        font-family: var(--display);
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        letter-spacing: -0.01em;
        transition: all 0.2s;
        border: 1.5px solid var(--ink);
      }
      .btn-primary:hover {
        background: var(--accent);
        border-color: var(--accent);
        transform: translateY(-1px);
      }
      .btn-ghost {
        background: transparent;
        color: var(--ink);
        padding: 14px 28px;
        border-radius: 6px;
        font-family: var(--display);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        border: 1.5px solid var(--border);
        transition: all 0.2s;
      }
      .btn-ghost:hover {
        border-color: var(--ink);
      }

      .hero-badges {
        display: flex;
        gap: 24px;
        margin-top: 3rem;
        flex-wrap: wrap;
        animation: fadeUp 0.7s 0.4s ease both;
      }
      .badge {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
      }
      .badge b {
        color: var(--ink);
      }

      .hero-social {
        display: flex;
        gap: 8px;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
        animation: fadeUp 0.7s 0.05s ease both;
      }
      .social-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: white;
        border: 1px solid var(--border);
        border-radius: 100px;
        padding: 5px 12px;
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--ink);
        text-decoration: none;
        transition: all 0.2s;
      }
      .social-badge:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-1px);
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ─── SECTION ─── */
      .section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 6rem 2rem;
      }
      .section-label {
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--accent);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
      }
      h2 {
        font-family: var(--display);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1;
        margin-bottom: 1rem;
      }
      .section-desc {
        color: var(--muted);
        max-width: 560px;
        font-weight: 300;
        margin-bottom: 3rem;
      }

      /* ─── ABOUT / PROBLEM-SOLUTION ─── */
      .about-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
      }
      .callout {
        border-radius: 10px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
        font-size: 0.9rem;
      }
      .callout.problem {
        background: #fff3ef;
        border-left: 3px solid var(--warn);
      }
      .callout.solution {
        background: #edfbf7;
        border-left: 3px solid var(--accent2);
      }
      .callout strong {
        display: block;
        margin-bottom: 0.25rem;
        font-family: var(--display);
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .highlights-box {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1.5rem;
      }
      .highlights-box h4 {
        font-family: var(--display);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1rem;
      }
      .hl-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 0.6rem 0;
        border-bottom: 1px solid var(--border);
      }
      .hl-item:last-child {
        border: none;
        padding-bottom: 0;
      }
      .hl-num {
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--accent);
        min-width: 20px;
        margin-top: 3px;
      }
      .hl-item p {
        font-size: 0.88rem;
        color: var(--muted);
      }
      .hl-item strong {
        color: var(--ink);
      }

      .how-it-works {
      }
      .how-it-works h3 {
        font-family: var(--display);
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;
      }
      .step-flow {
        display: flex;
        flex-direction: column;
        gap: 0;
      }
      .flow-item {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
        padding: 1rem 0;
        position: relative;
      }
      .flow-item::before {
        content: "";
        position: absolute;
        left: 19px;
        top: 44px;
        width: 2px;
        height: calc(100% - 12px);
        background: var(--border);
      }
      .flow-item:last-child::before {
        display: none;
      }
      .flow-num {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--ink);
        color: white;
        font-family: var(--mono);
        font-size: 0.75rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
      }
      .flow-text strong {
        font-family: var(--display);
        font-size: 0.9rem;
        display: block;
      }
      .flow-text span {
        font-size: 0.82rem;
        color: var(--muted);
      }

      .sse-note {
        background: #f8f8fc;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        font-size: 0.82rem;
        color: var(--muted);
        margin-top: 1.5rem;
      }
      code {
        font-family: var(--mono);
        font-size: 0.82em;
        background: rgba(26, 86, 255, 0.08);
        color: var(--accent);
        padding: 2px 6px;
        border-radius: 4px;
      }

      /* ─── FEATURES ─── */
      .features-bg {
        background: var(--ink);
      }
      .features-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 6rem 2rem;
      }
      .features-section .section-label {
        color: var(--accent2);
      }
      .features-section h2 {
        color: white;
      }
      .features-section .section-desc {
        color: rgba(255, 255, 255, 0.5);
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
      }
      .feat-card {
        background: var(--ink);
        padding: 2rem 1.75rem;
        transition: background 0.2s;
      }
      .feat-card:hover {
        background: #111118;
      }
      .feat-icon {
        font-size: 1.6rem;
        margin-bottom: 1rem;
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .feat-card h3 {
        font-family: var(--display);
        font-size: 1rem;
        font-weight: 700;
        color: white;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
      }
      .feat-card p {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.45);
        line-height: 1.55;
      }

      /* ─── APIs COMPARISON ─── */
      .apis-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2rem;
      }
      .api-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
      }
      .api-card-head {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .api-card-head h3 {
        font-family: var(--display);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .api-badge {
        font-family: var(--mono);
        font-size: 0.65rem;
        font-weight: 500;
        padding: 3px 8px;
        border-radius: 100px;
        margin-left: auto;
      }
      .api-badge.warn {
        background: #fff3ef;
        color: var(--warn);
      }
      .api-badge.ok {
        background: #edfbf7;
        color: #00a382;
      }
      .api-card-body {
        padding: 1.25rem 1.5rem;
      }

      .code-block {
        background: #0f1117;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
        overflow-x: auto;
      }
      .code-block pre {
        font-family: var(--mono);
        font-size: 0.75rem;
        color: #a0aec0;
        line-height: 1.7;
        margin: 0;
      }
      .code-block pre .hl {
        color: var(--accent2);
      }

      .api-note {
        font-size: 0.8rem;
        padding: 0.75rem 1rem;
        border-radius: 8px;
      }
      .api-note.warn {
        background: #fff8f5;
        color: #a05020;
      }
      .api-note.ok {
        background: #f0fdf9;
        color: #166a57;
      }

      .multi-config {
        background: white;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
      }
      .multi-config-head {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .multi-config-head h4 {
        font-family: var(--display);
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .tip-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
      }

      /* ─── INSTALLATION ─── */
      .install-bg {
        background: var(--paper);
      }
      .tabs-row {
        display: flex;
        gap: 6px;
        margin-bottom: 1.5rem;
      }
      .tab-btn {
        font-family: var(--display);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 8px 18px;
        border-radius: 6px;
        border: 1.5px solid var(--border);
        background: white;
        color: var(--muted);
        cursor: pointer;
        transition: all 0.15s;
      }
      .tab-btn.active {
        background: var(--ink);
        color: white;
        border-color: var(--ink);
      }
      .tab-pane {
        display: none;
      }
      .tab-pane.active {
        display: block;
      }

      /* ─── QUICK START ─── */
      .steps-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .qs-step {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
      }
      .qs-step-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      .qs-num {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--ink);
        color: white;
        font-family: var(--mono);
        font-size: 0.78rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .qs-step-head h3 {
        font-family: var(--display);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .qs-step-body {
        padding: 1.25rem 1.5rem;
      }
      .qs-step-body p {
        font-size: 0.875rem;
        color: var(--muted);
      }

      /* ─── CONFIG ─── */
      .config-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }
      .config-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
      }
      .config-card-head {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .config-card-head h3 {
        font-family: var(--display);
        font-weight: 700;
        font-size: 0.95rem;
      }
      .config-card-body {
        padding: 0;
      }

      /* ─── FOOTER ─── */
      footer {
        background: var(--ink);
        color: white;
        padding: 4rem 2rem 3rem;
      }
      .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        text-align: center;
      }
      .footer-logo {
        font-family: var(--display);
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.04em;
      }
      .footer-links {
        display: flex;
        gap: 2rem;
        list-style: none;
        flex-wrap: wrap;
        justify-content: center;
      }
      .footer-links a {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
        text-decoration: none;
        transition: color 0.2s;
      }
      .footer-links a:hover {
        color: white;
      }
      .footer-copy {
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.25);
        font-family: var(--mono);
      }

      /* ─── DIVIDER ─── */
      .divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0;
      }

      .kofi-btn {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 999;
        transition: transform 0.2s;
      }
      .kofi-btn:hover {
        transform: scale(1.05);
      }

      /* ─── NAV ACTIONS ─── */
      .nav-actions {
        display: flex;
        align-items: center;
      }
      .nav-btn {
        background: var(--accent);
        color: white;
        padding: 8px 18px;
        border-radius: 6px;
        font-family: var(--display);
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
      }
      .nav-btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
      }

      /* ─── DASHBOARD MOCKUP ─── */
      .dash-card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .dash-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
      }
      .dash-status-dot.online { background: var(--accent2); }
      .dash-status-dot.offline { background: var(--warn); }
      .dash-copy-btn {
        background: var(--accent);
        color: white;
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-family: var(--mono);
        font-size: 0.65rem;
        cursor: pointer;
        transition: all 0.2s;
      }
      .dash-copy-btn:hover { opacity: 0.85; }
      .dash-copy-btn:disabled {
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.3);
        border: 1px solid rgba(255,255,255,0.1);
        cursor: not-allowed;
      }
      .dash-logs {
        background: #0a0a0f;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        overflow: hidden;
      }
      .dash-logs-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }
      .dash-logs-body {
        padding: 1rem 1.25rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        line-height: 1.8;
        color: #a0aec0;
      }
      .dash-logs-body .info-line { color: var(--accent2); }
      .log-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: var(--accent2);
        display: inline-block;
        animation: pulse 2s infinite;
      }

      /* ─── PRICING ─── */
      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        max-width: 1100px;
        margin: 0 auto;
      }
      .pricing-card {
        padding: 2.5rem 2rem;
        text-align: center;
      }
      .pricing-card.popular {
        position: relative;
      }
      .pricing-popular-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: var(--accent);
        color: white;
        font-family: var(--mono);
        font-size: 0.6rem;
        padding: 3px 8px;
        border-radius: 100px;
        letter-spacing: 0.05em;
      }
      .pricing-name {
        font-family: var(--display);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--accent2);
        margin-bottom: 0.5rem;
      }
      .pricing-price {
        font-family: var(--display);
        font-size: 2.5rem;
        font-weight: 800;
        color: white;
        margin-bottom: 0.25rem;
      }
      .pricing-desc {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.35);
        margin-bottom: 2rem;
      }
      .pricing-features {
        list-style: none;
        text-align: left;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.6);
        line-height: 2;
        margin-bottom: 2rem;
      }

      /* ─── ZERO-KNOWLEDGE BADGE ─── */
      .zk-badge {
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--accent2);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        background: #edfbf7;
        padding: 4px 10px;
        border-radius: 100px;
        display: inline-block;
      }

      /* ─── FAQ ─── */
      .faq-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        max-width: 1100px;
        margin: 0 auto;
      }

      @media (max-width: 768px) {
        .about-layout,
        .apis-grid,
        .config-grid,
        .features-grid,
        .pricing-grid,
        .faq-grid {
          grid-template-columns: 1fr;
        }
        .sec-grid {
          grid-template-columns: 1fr !important;
        }
        .features-grid {
          gap: 1px;
        }
        .nav-links {
          display: none;
        }
        h1 {
          font-size: 2.8rem;
        }
        .pricing-card.popular {
          order: -1;
        }
      }

      /* ─── SVG ICON HELPERS ─── */
      .svg-icon { display: inline-flex; align-items: center; }
      .api-head-icon { display: inline-flex; align-items: center; color: var(--muted); }
      .check-icon { display: inline-flex; align-items: center; margin-right: 4px; }
      .pricing-features li { display: flex; align-items: center; gap: 0; }

      /* ─── MODAL GLASSMORPHIC LOGIN ─── */
      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 10, 15, 0.4);
        backdrop-filter: blur(8px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }
      .modal-overlay.open {
        opacity: 1;
        pointer-events: auto;
      }
      .modal-box {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 16px;
        padding: 2.25rem 2rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        transform: translateY(20px);
        transition: transform 0.3s ease;
        text-align: center;
      }
      .modal-overlay.open .modal-box {
        transform: translateY(0);
      }
      .modal-header h3 {
        font-family: var(--display);
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: var(--ink);
        letter-spacing: -0.02em;
      }
      .modal-sub {
        font-size: 0.88rem;
        color: var(--muted);
        margin-bottom: 2rem;
      }
      .social-login-container {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .social-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        font-family: var(--display);
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
        border: 1.5px solid var(--border);
      }
      .social-icon {
        width: 18px;
        height: 18px;
      }
      .google-btn {
        background: #ffffff;
        color: var(--ink);
      }
      .google-btn:hover {
        background: #f7f9fa;
        border-color: var(--ink);
      }
      .github-btn {
        background: #24292e;
        color: #ffffff;
        border-color: #24292e;
      }
      .github-btn:hover {
        background: #1b1f23;
        opacity: 0.95;
      }
      .apple-btn {
