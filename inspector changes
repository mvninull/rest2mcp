def _extract_env_schema(server_data: dict) -> dict | None:
    packages = server_data.get("packages") or []
    all_env_vars: list[dict] = []
    for pkg in packages:
        env_vars = pkg.get("environmentVariables") or []
        all_env_vars.extend(env_vars)
    
    if not all_env_vars:
        return None
    
    properties = {}
    required = []
    for ev in all_env_vars:
        name = ev.get("name")
        if not name:
