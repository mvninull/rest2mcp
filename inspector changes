}
.log-detail-box .modal-header {
    margin-bottom: 1rem;
}
.log-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 1.2rem;
}
.log-detail-meta-item {
    display: flex;
